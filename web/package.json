{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "certs": "node scripts/dev-certs.mjs",
    "dev:https": "next dev --turbopack -p 3443 --experimental-https --experimental-https-key ../certs/dev-key.pem --experimental-https-cert ../certs/dev-cert.pem --experimental-https-ca ../certs/yapster-dev-ca.pem",
    "icons": "node scripts/icons.mjs",
    "smoke:sw": "node scripts/sw-smoke.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.3.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
