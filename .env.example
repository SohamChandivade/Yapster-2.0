# ── Postgres (docker compose) ───────────────────────────────────
POSTGRES_USER=yapster
POSTGRES_PASSWORD=yapster
POSTGRES_DB=yapster

# ── API ─────────────────────────────────────────────────────────
APP_ENV=dev
# Local dev against the compose db. Inside compose the host is "db".
DATABASE_URL=postgresql+asyncpg://yapster:yapster@localhost:5432/yapster
# JSON list
CORS_ORIGINS=["http://localhost:3000"]

# ── LLM (milestone 2; all free tiers) ───────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# Provider chains, "provider:model" comma-separated, tried in order (see CLAUDE.md §11)
LLM_CHAT_CHAIN=gemini:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b,mistral:ministral-14b-latest
LLM_BATCH_CHAIN=gemini:gemini-3.8-flash,mistral:ministral-14b-latest,groq:openai/gpt-oss-120b

# ── Web ─────────────────────────────────────────────────────────
# Optional override. Leave unset: the web app calls the API on the same host it was
# loaded from (port 8000), which also works on a phone over the hotspot.
# NEXT_PUBLIC_API_URL=http://localhost:8000
